
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: '배포 환경 (dev=mannamsquare.com, prod=goldpet.com)'
        )
    }

    environment {
        BASTION_HOST = '10.1.0.242'
        DEPLOY_HOST = '10.1.11.22'
        DEPLOY_USER = 'deploy'

        REMOTE_STAGE = '/home/deploy/staging/admin'
    }

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('admin') {
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                catchError(
                    buildResult: 'SUCCESS',
                    stageResult: 'UNSTABLE'
                ) {
                    dir('admin') {
                        sh '''
                            npm run lint
                            npm run lint:contract
                        '''
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('admin') {
                    sh "npm run build -- --mode ${params.ENV}"
                }
            }
        }

        stage('Package') {
            steps {
                dir('admin') {
                    sh '''
                        set -eu

                        test -d dist
                        test -s dist/index.html

                        tar -czf ../admin.tar.gz \
                            -C dist .
                    '''
                }
            }
        }

        stage('Check SSH') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        ssh \
                          -o BatchMode=yes \
                          -o ConnectTimeout=10 \
                          -J "${DEPLOY_USER}@${BASTION_HOST}" \
                          "${DEPLOY_USER}@${DEPLOY_HOST}" \
                          'whoami && hostname'
                    '''
                }
            }
        }

        stage('Upload') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        set -eu

                        scp \
                          -o BatchMode=yes \
                          -o ProxyJump="${DEPLOY_USER}@${BASTION_HOST}" \
                          admin.tar.gz \
                          "${DEPLOY_USER}@${DEPLOY_HOST}:${REMOTE_STAGE}/admin-${BUILD_NUMBER}.tar.gz"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        ssh \
                          -o BatchMode=yes \
                          -J "${DEPLOY_USER}@${BASTION_HOST}" \
                          "${DEPLOY_USER}@${DEPLOY_HOST}" \
                          "sudo -n /usr/local/sbin/deploy-goldpet-admin '${ENV}' '${BUILD_NUMBER}'"
                    '''
                }
            }
        }

        stage('Verify Public URL') {
            steps {
                script {
                    def checkUrl = params.ENV == 'dev'
                        ? 'https://admin.mannamsquare.com'
                        : 'https://admin.goldpet.com'

                    sh """
                        curl --fail --silent --show-error \
                            --max-time 15 \
                            '${checkUrl}' > /dev/null
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Admin 배포 성공! (ENV: ${params.ENV})"
        }

        failure {
            echo "❌ Admin 빌드 또는 배포 실패! (ENV: ${params.ENV})"
        }

        unstable {
            echo "⚠️ Admin 테스트 일부 실패 (UNSTABLE)"
        }
    }
}
