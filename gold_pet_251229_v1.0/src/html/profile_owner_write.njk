{%- extends "_templates/_layout.njk" -%}
{% block content %}
<div id="profileContainer">
    <div class="profile_write">
        <div class="profile_img_edit">
            <!--
                profile_img 내에 이미지 태그 넣으면 src대로 이미지 노출,
                반려인 none이미지는 img 태그만 삭제하면 노출
               -->
            <div class="profile_img"><img src="../assets/images/main/main_slide_butler02.png" alt=""></div>
        </div>
        <div class="name_input">
            <label for="name">닉네임</label>
            <input type="text" id="name" placeholder="닉네임을 적어주세요.">
        </div>
        <div class="profile_write_wrap">
            <strong>기본 정보</strong>
            <div class="profile_write_box pink_color">
                <div class="write_box">
                    <label for="owner_age">나이</label>
                    <input type="text" id="owner_age" placeholder="나이를 입력해주세요.">
                </div>
                <div class="write_box write_select">
                    <label for="owner_gender">성별</label>
                    <select name="" id="owner_gender">
                        <option value="man">남성</option>
                        <option value="woman">여성</option>
                    </select>
                </div>
            </div>
        </div>
        <button type="button" class="submit_btn">확인</button>
    </div>
</div>
{%- endblock %}
