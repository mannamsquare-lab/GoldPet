{%- extends "_templates/_layout.njk" -%}
{% block content %}
<div id="profileContainer">
    <div class="talk_wrap">
        <p>
            반려동물과 함께하는 <br>
            행복한 일상을 같이 공유하고 싶어요
        </p>
        <button type="button"><img src="../assets/images/common/pin_icon.svg" alt="지도 마커">서울 강남구</button>
    </div>
    <div class="profile_info_wrap">
        <div class="profile_name_info">
            <div class="couple_img">
                <div class="name_edit name_edit01">
                    <!--
                    profile_img 내에 이미지 태그 넣으면 src대로 이미지 노출,
                    반려인 none이미지는 img 태그만 삭제하면 노출
                    반려동물 none 이미지는 profile_img에 pet_none class 넣으면 노출
                    -->
                    <div class="profile_img">
                        <img src="../assets/images/main/main_slide_butler01.jpg" alt="">
                    </div>
                    <strong>망고</strong>
                    <button type="button">수정</button>
                </div>
                <div class="name_edit name_edit02">
                    <div class="profile_img"><img src="../assets/images/main/main_slide_butler02.png" alt=""></div>
                    <strong>난완전멋쟁이</strong>
                    <button type="button">수정</button>
                </div>
            </div>
            <div class="count_wrap">
                <dl>
                    <dt>매칭</dt>
                    <dd>128</dd>
                </dl>
                <div></div>
                <dl>
                    <dt>좋아요</dt>
                    <dd>2.4K</dd>
                </dl>
                <div></div>
                <dl>
                    <dt>친구</dt>
                    <dd>48</dd>
                </dl>
            </div>
        </div>

        <ul class="profile_tab">
            <li><button type="button" class="active">반려인</button></li>
            <li><button type="button">반려동물</button></li>
        </ul>

        <!--box_wrap에 pink_color,purple_color,blue_color,green_color class로 색상 조절-->
        <div class="profile_info_box">
            <strong>기본 정보</strong>
            <div class="box_wrap pink_color">
                <dl>
                    <dt>나이</dt>
                    <dd>3세</dd>
                </dl>
                <dl>
                    <dt>성별</dt>
                    <dd>여아</dd>
                </dl>
                <dl>
                    <dt>중성화</dt>
                    <dd>완료</dd>
                </dl>
                <dl>
                    <dt>품종</dt>
                    <dd>브리티시 쇼트헤어</dd>
                </dl>
            </div>

            <strong>성향</strong>
            <div class="box_wrap purple_color">
                <dl>
                    <dt>활동성</dt>
                    <dd>매우 활발함</dd>
                </dl>
                <dl>
                    <dt>친화력</dt>
                    <dd>매우 좋음</dd>
                </dl>
                <dl>
                    <dt>훈련도</dt>
                    <dd>우수함(전문교육수료)</dd>
                </dl>
                <dl>
                    <dt>짖음</dt>
                    <dd>거의 없음</dd>
                </dl>
                <dl>
                    <dt>특이사항</dt>
                    <dd>산책을 매우 좋아하고 다른 강아지와도 잘 어울려요. 특히 공놀이를 너무나 좋아해서 피곤할 정도! ; )</dd>
                </dl>
            </div>

            <strong>알러지 정보</strong>
            <div class="box_wrap blue_color">
                <dl>
                    <dt>견과류</dt>
                    <dd>주의 필요</dd>
                </dl>
                <dl>
                    <dt>갑각류</dt>
                    <dd>안전</dd>
                </dl>
                <dl>
                    <dt>달걀&육류</dt>
                    <dd>안정</dd>
                </dl>
                <dl>
                    <dt>기타</dt>
                    <dd>없음</dd>
                </dl>
            </div>

            <strong>관심사</strong>
            <div class="box_wrap green_color">
                <dl>
                    <dt>장난감 놀이</dt>
                    <dd>매우 좋아함</dd>
                </dl>
                <dl>
                    <dt>산책</dt>
                    <dd>매우 좋아함</dd>
                </dl>
                <dl>
                    <dt>수명</dt>
                    <dd>보통</dd>
                </dl>
                <dl>
                    <dt>쓰다듬기</dt>
                    <dd>매우 좋아함</dd>
                </dl>
            </div>
        </div>
        <div class="check_wrap">
            <div class="check_box">
                <input type="checkbox" id="alram">
                <label for="alram">알림설정</label>
            </div>

            <div class="check_box">
                <input type="checkbox" id="location">
                <label for="location">위치기반</label>
            </div>

            <a href="" class="white_link">약관</a>
        </div>
    </div>
</div>
{%- endblock %}















