# GoldPet .gitignore

# -----------------
# 1. Global / OS / IDE
# -----------------
.DS_Store
.localized
Thumbs.db
Desktop.ini

# IDEs
.idea/
.vscode/
*.iml
*.ipr
*.iws

# -----------------
# 2. Logs & Temporary Files
# -----------------
*.log
*.tmp
*.swp
*.bak
/coverage/

# -----------------
# 3. Environment & Secrets
# -----------------
# .env 파일은 private repo이므로 커밋 허용
*.pem
*.key
*.crt
*.p12
id_rsa
# Specific sensitive directories
keys/*.json
# Firebase service account (private key)
**/firebase-service-account.json

# -----------------
# 4. Backend (API) - Java / Spring Boot / Gradle
# -----------------
api/.gradle/
api/build/
api/out/
api/target/
api/bin/
api/logs/
api/gradle.properties
# Keep gradle-wrapper.jar usually, but exclude if user wants completely clean. Assuming standard practice: Keep wrapper.

# -----------------
# 5. Mobile App (Flutter)
# -----------------
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/build/
# Android
app/android/.gradle/
app/android/local.properties
app/android/app/build/
app/android/.idea/
app/android/.cxx/
# iOS
app/ios/.symlinks/
app/ios/Pods/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/App.framework
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
# macOS
app/macos/Flutter/ephemeral/

# -----------------
# 6. Frontend (React) & Admin (React/Vite)
# -----------------
# Dependencies
frontend/node_modules/
admin/node_modules/

# Build Outputs
frontend/dist/
frontend/build/
admin/dist/
admin/build/

# Cache & Misc
frontend/.cache/
admin/.cache/
frontend/.eslintcache
admin/.eslintcache

# -----------------
# 7. Infrastructure & Docker
# -----------------
# Docker volumes (data persistence)
infra/data/
infra/postgres_data/
infra/redis_data/
infra/minio_data/
infra/jenkins_home/

# -----------------
# 8. Python / AI (Scripts)
# -----------------
__pycache__/
*.pyc
*.pyo
.venv/
env/
venv/
.pytest_cache/
.ipynb_checkpoints/

# -----------------
# 9. Project Resources & Documentation (Korean folders)
# -----------------
# Resource files (large assets, zips)
resource/
/resources/

# Test data
테스트데이터/
test-data/

# Documentation (internal planning docs)
docs/기획문서/

# Brain artifacts (local AI assistant artifacts)
.gemini/

# OMC
.omc/

.claude/

.mcp.json

.playwright-mcp/
.claude/settings.local.json
