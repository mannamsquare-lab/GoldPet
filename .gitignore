# .gitignore for GoldPet Project

# Operating System (macOS)
.DS_Store
.localized

# IDE (IntelliJ / VS Code)
.idea/
.vscode/
*.iml
*.ipr
*.iws
out/
target/

# Backend (Kotlin / Gradle)
.gradle/
backend/build/
backend/.gradle/

# AI (Python)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.ipynb_checkpoints/
ai-server/build/

# App (Flutter)
.flutter/
.dart_tool/
.packages
build/
android/.gradle
android/local.properties
ios/.symlinks
ios/.generated
ios/Flutter/Generated.xcconfig
ios/Flutter/App.framework
ios/Flutter/flutter_assets

# General / Temporary
*.log
*.tmp
*.swp
/coverage
*.pem

# Environment Variables
.env
.env*.local