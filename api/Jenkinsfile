pipeline {
    agent any
    
    parameters {
        choice(name: 'PROFILE', choices: ['dev', 'prod'], description: 'Select the profile to deploy (dev/prod)')
    }
    
    environment {
        DEPLOY_PATH = '/home/dev/www/mannam/goldpet/api'
        JAR_NAME = 'goldpet-api.jar'
    }
    
    stages {
        stage('OpenAPI Spec Drift Gate') {
            steps {
                // Phase 2 / 4 — verifyOpenApiSpec regenerates the spec into a temp
                // file and fails the build if the sha256 differs from the committed
                // api/openapi.json. Catches "shipped backend change without
                // regenerating the spec" before deploy.
                dir('api') {
                    sh './gradlew verifyOpenApiSpec'
                }
            }
        }

        stage('Build') {
            steps {
                dir('api') {
                    sh './gradlew clean bootJar'
                }
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying with profile: ${params.PROFILE}"
                    
                    // 백업
                    sh """
                        if [ -f ${DEPLOY_PATH}/${JAR_NAME} ]; then
                            cp ${DEPLOY_PATH}/${JAR_NAME} ${DEPLOY_PATH}/${JAR_NAME}.backup.\$(date +%Y%m%d_%H%M%S)
                        fi
                    """
                    
                    // 환경 변수 파일 업데이트 — SPRING_PROFILES_ACTIVE만 교체하고
                    // ENCRYPTION_KEY* 등 나머지 비밀키는 보존. `>` 덮어쓰기를 쓰면
                    // 매 배포마다 비밀키가 사라져 센티넬 가드가 앱 기동을 거부함.
                    sh """
                        ENV_FILE=${DEPLOY_PATH}/goldpet-api.env
                        TMP=\$(mktemp)
                        if [ -f \$ENV_FILE ]; then
                            grep -v '^SPRING_PROFILES_ACTIVE=' \$ENV_FILE > \$TMP || true
                        fi
                        echo 'SPRING_PROFILES_ACTIVE=${params.PROFILE}' >> \$TMP
                        mv \$TMP \$ENV_FILE
                    """
                    
                    // 서비스 중지
                    sh 'sudo systemctl stop goldpet-api || true'
                    
                    // JAR 복사
                    sh "cp api/build/libs/*.jar ${DEPLOY_PATH}/${JAR_NAME}"
                    
                    // 서비스 시작
                    sh 'sudo systemctl start goldpet-api'
                    
                    // 헬스체크
                    sh '''#!/bin/bash
                        echo "Waiting for API to start..."
                        sleep 3
                        for i in $(seq 1 30); do
                            HTTP_CODE=$(curl -s -o /dev/null -w '%{http_code}' http://localhost:8081/actuator/health)
                            if [ "$HTTP_CODE" = "200" ]; then
                                echo "✅ API is up and running! (HTTP $HTTP_CODE)"
                                exit 0
                            fi
                            echo "Attempt $i/30 (HTTP $HTTP_CODE)..."
                            sleep 2
                        done
                        echo "❌ API failed to start"
                        # 로그 출력 (디버깅용)
                        journalctl -u goldpet-api -n 50 --no-pager
                        exit 1
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ Backend 배포 성공! (Profile: ${params.PROFILE})"
        }
        failure {
            echo "❌ Backend 배포 실패! (Profile: ${params.PROFILE})"
            // 롤백
            sh """
                if ls ${DEPLOY_PATH}/${JAR_NAME}.backup.* 1> /dev/null 2>&1; then
                    LATEST_BACKUP=\$(ls -t ${DEPLOY_PATH}/${JAR_NAME}.backup.* | head -1)
                    cp \$LATEST_BACKUP ${DEPLOY_PATH}/${JAR_NAME}
                    sudo systemctl restart goldpet-api
                    echo "Rolled back to \$LATEST_BACKUP"
                fi
            """
        }
        always {
            // 오래된 백업 파일 정리 (최근 3개만 유지)
            sh """
                cd ${DEPLOY_PATH}
                ls -t ${JAR_NAME}.backup.* 2>/dev/null | tail -n +4 | xargs rm -f || true
            """
        }
    }
}
