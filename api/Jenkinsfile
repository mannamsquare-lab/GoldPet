pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        choice(
            name: 'PROFILE',
            choices: ['dev', 'prod'],
            description: 'Select deployment profile'
        )
    }

    environment {
        BASTION_HOST = '10.1.0.242'
        DEPLOY_HOST = '10.1.11.22'
        DEPLOY_USER = 'deploy'

        JAR_NAME = 'goldpet-api.jar'
        REMOTE_STAGE = '/home/deploy/staging/api'
    }

    stages {
        stage('OpenAPI Spec Drift Gate') {
            steps {
                dir('api') {
                    sh '''
                        mkdir -p build
                        cp openapi.json build/openapi-committed.json
                        ./gradlew verifyOpenApiSpec
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('api') {
                    sh './gradlew clean bootJar'
                }
            }
        }

        stage('Prepare Artifact') {
            steps {
                sh '''
                    set -eu

                    # 실행 가능한 bootJar 확인
                    JARS=$(find api/build/libs \
                        -maxdepth 1 \
                        -type f \
                        -name '*.jar' \
                        ! -name '*-plain.jar')

                    COUNT=$(printf '%s\\n' "$JARS" |
                        sed '/^$/d' | wc -l)

                    if [ "$COUNT" -ne 1 ]; then
                        echo "Expected one bootJar, found $COUNT"
                        exit 1
                    fi

                    cp "$JARS" goldpet-api.jar
                    test -s goldpet-api.jar

                    sha256sum goldpet-api.jar
                '''
            }
        }

        stage('Check SSH') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        ssh \
                          -o BatchMode=yes \
                          -o ConnectTimeout=10 \
                          -J "${DEPLOY_USER}@${BASTION_HOST}" \
                          "${DEPLOY_USER}@${DEPLOY_HOST}" \
                          'whoami && hostname'
                    '''
                }
            }
        }

        stage('Upload JAR') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        scp \
                          -o BatchMode=yes \
                          -o ProxyJump="${DEPLOY_USER}@${BASTION_HOST}" \
                          goldpet-api.jar \
                          "${DEPLOY_USER}@${DEPLOY_HOST}:${REMOTE_STAGE}/goldpet-api.jar"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        ssh \
                          -o BatchMode=yes \
                          -J "${DEPLOY_USER}@${BASTION_HOST}" \
                          "${DEPLOY_USER}@${DEPLOY_HOST}" \
                          "sudo -n /usr/local/sbin/deploy-goldpet-api '${PROFILE}'"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Backend 배포 성공! (${params.PROFILE})"
        }

        failure {
            echo "❌ Backend 빌드 또는 배포 실패! (${params.PROFILE})"
        }
    }
}
