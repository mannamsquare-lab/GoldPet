
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'prod'],
            description: '배포 환경 (dev=mannamsquare.com, prod=goldpet.com)'
        )
    }

    environment {
        BASTION_HOST = '10.1.0.242'
        DEPLOY_HOST = '10.1.11.22'
        DEPLOY_USER = 'deploy'

        REMOTE_STAGE = '/home/deploy/staging/frontend'
    }

    tools {
        nodejs 'NodeJS'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                catchError(
                    buildResult: 'SUCCESS',
                    stageResult: 'UNSTABLE'
                ) {
                    dir('frontend') {
                        sh 'npm run lint'
                        sh 'npm run lint:contract'
                        sh 'npm run test -- --run'
                    }
                }
            }
        }

        stage('OpenAPI Contract Test (dev)') {
            when {
                expression { params.ENV == 'dev' }
            }

            steps {
                catchError(
                    buildResult: 'SUCCESS',
                    stageResult: 'UNSTABLE'
                ) {
                    dir('frontend') {
                        sh '''
                            OPENAPI_CONTRACT_BASE=https://api.mannamsquare.com \
                                npx playwright test api-contract.spec.ts --reporter=line
                        '''
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh "npm run build:${params.ENV}"
                }
            }
        }

        stage('Package') {
            steps {
                dir('frontend') {
                    sh '''
                        set -eu

                        test -d dist
                        test -s dist/index.html

                        tar -czf ../frontend.tar.gz \
                            -C dist .
                    '''
                }
            }
        }

        stage('Check SSH') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        ssh \
                          -o BatchMode=yes \
                          -o ConnectTimeout=10 \
                          -J "${DEPLOY_USER}@${BASTION_HOST}" \
                          "${DEPLOY_USER}@${DEPLOY_HOST}" \
                          'whoami && hostname'
                    '''
                }
            }
        }

        stage('Upload') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        set -eu

                        scp \
                          -o BatchMode=yes \
                          -o ProxyJump="${DEPLOY_USER}@${BASTION_HOST}" \
                          frontend.tar.gz \
                          "${DEPLOY_USER}@${DEPLOY_HOST}:${REMOTE_STAGE}/frontend-${BUILD_NUMBER}.tar.gz"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: ['goldpet-deploy-ssh']) {
                    sh '''
                        ssh \
                          -o BatchMode=yes \
                          -J "${DEPLOY_USER}@${BASTION_HOST}" \
                          "${DEPLOY_USER}@${DEPLOY_HOST}" \
                          "sudo -n /usr/local/sbin/deploy-goldpet-frontend '${ENV}' '${BUILD_NUMBER}'"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Frontend 배포 성공! (ENV: ${params.ENV})"
        }

        failure {
            echo "❌ Frontend 배포 실패! (ENV: ${params.ENV})"
        }

        unstable {
            echo "⚠️ Frontend 테스트 일부 실패 (UNSTABLE)"
        }
    }
}
